@model TrainerAvailabilityViewModel
@{
    ViewData["Title"] = "Availability";
    var days = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };
}
<div class="page-header">
    <div>
        <h1 class="page-title">Consultation availability</h1>
        <p class="page-subtitle">Clients can only request appointments inside these weekly hours. With no hours set, any time can be requested.</p>
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-5">
        <form asp-action="Availability" method="post" class="card-ht">
            <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-plus-circle"></i>Add hours</h2></div>
            <div class="card-ht-body">
                <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
                <div class="mb-3">
                    <label class="form-label" for="DayOfWeek">Day</label>
                    <select class="form-select" id="DayOfWeek" name="DayOfWeek">
                        @foreach (var d in days)
                        {
                            if (d == Model.DayOfWeek) { <option value="@((int)d)" selected>@d</option> }
                            else { <option value="@((int)d)">@d</option> }
                        }
                    </select>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label" for="StartTime">From</label>
                        <input class="form-control" type="time" id="StartTime" name="StartTime" value="@(Model.StartTime?.ToString("hh\\:mm"))" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="EndTime">To</label>
                        <input class="form-control" type="time" id="EndTime" name="EndTime" value="@(Model.EndTime?.ToString("hh\\:mm"))" required />
                    </div>
                </div>
            </div>
            <div class="card-ht-footer text-end"><button type="submit" class="btn btn-primary">Add slot</button></div>
        </form>
    </div>
    <div class="col-lg-7">
        <div class="card-ht">
            <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-calendar-week"></i>Weekly schedule</h2></div>
            <ul class="list-clean">
                @foreach (var d in days)
                {
                    var slots = Model.Slots.Where(s => s.DayOfWeek == d).OrderBy(s => s.StartTime).ToList();
                    <li class="list-row">
                        <div style="width:110px" class="fw-bold">@d</div>
                        <div class="grow d-flex flex-wrap gap-2">
                            @if (slots.Count == 0) { <span class="text-muted small">Not available</span> }
                            @foreach (var s in slots)
                            {
                                <form asp-action="RemoveSlot" asp-route-id="@s.Id" method="post" class="d-inline">
                                    <span class="badge-soft primary">@s.StartTime.ToString("hh\\:mm") – @s.EndTime.ToString("hh\\:mm")
                                        <button type="submit" class="btn btn-link btn-sm p-0 ms-1 text-danger" title="Remove"><i class="bi bi-x-circle"></i></button>
                                    </span>
                                </form>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
