@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="container py-5" style="max-width:640px">
    <div class="card-ht text-center">
        <div class="card-ht-body p-5">
            <div class="icon-bubble rose mx-auto mb-3" style="width:56px;height:56px;font-size:1.5rem"><i class="bi bi-exclamation-octagon"></i></div>
            <h1 class="h3">Something went wrong</h1>
            <p class="text-muted">An unexpected error occurred while processing your request. The problem has been logged.</p>
            @if (Model.ShowRequestId)
            {
                <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
            }
            <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Back to HealthTrack</a>
        </div>
    </div>
</div>
