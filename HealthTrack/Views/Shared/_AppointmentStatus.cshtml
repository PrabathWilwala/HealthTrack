@model Appointment
<span class="badge-soft @DisplayHelpers.StatusClass(Model.Status)"><span class="status-dot"></span>@Model.Status</span>
@if (Model.ProposedStartTime != null)
{
    <span class="badge-soft teal ms-1" title="Proposed: @Model.ProposedStartTime.Value.ToString("ddd dd MMM, HH:mm")"><i class="bi bi-arrow-repeat"></i>Reschedule requested</span>
}
