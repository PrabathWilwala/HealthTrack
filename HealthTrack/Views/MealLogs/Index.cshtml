@model LogHistoryViewModel<MealLog>
@{
    ViewData["Title"] = "Meal log";
    var days = Model.Items.GroupBy(m => m.LogDate.Date).OrderByDescending(g => g.Key).ToList();
}
<h1>Meals</h1>
<p>Your food diary. Entries can be edited or deleted for @ClientLogControllerBase.EditWindowDays days.</p>
<p><a asp-action="Create">Log meal</a></p>

<p>
    Meals logged: @Model.Items.Count |
    Avg. daily calories: @(days.Count == 0 ? 0 : (int)days.Average(d => d.Sum(m => m.Calories))) kcal |
    Avg. daily protein: @(days.Count == 0 ? "0" : days.Average(d => d.Sum(m => m.ProteinG)).ToString("0")) g |
    Days logged: @days.Count
</p>

<partial name="_DateRangeFilter" model="new DateRange(Model.From, Model.To)" />

@if (Model.Items.Count == 0)
{
    <p>No meals in this period. <a asp-action="Create">Log a meal</a></p>
}
else
{
    <table border="1" cellpadding="4">
        <thead><tr><th>Meal</th><th>Food</th><th>Portion</th><th>Calories</th><th>Protein</th><th>Carbs</th><th>Fat</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var day in days)
            {
                <tr>
                    <th colspan="3">@day.Key.ToString("dddd, dd MMM yyyy")</th>
                    <th>@day.Sum(m => m.Calories) kcal</th>
                    <th>@day.Sum(m => m.ProteinG).ToString("0") g</th>
                    <th>@day.Sum(m => m.CarbsG).ToString("0") g</th>
                    <th>@day.Sum(m => m.FatG).ToString("0") g</th>
                    <th></th>
                </tr>
                foreach (var m in day.OrderBy(x => x.MealType))
                {
                    var editable = m.CreatedAtUtc >= Model.EditableAfterUtc;
                    <tr>
                        <td>@m.MealType</td>
                        <td>@m.FoodItems
                            @if (Model.FeedbackCounts.TryGetValue(m.Id, out var fc)) { <a asp-controller="Client" asp-action="Feedback">(@fc feedback)</a> }
                        </td>
                        <td>@m.Portion</td>
                        <td>@m.Calories</td>
                        <td>@m.ProteinG.ToString("0.#")</td>
                        <td>@m.CarbsG.ToString("0.#")</td>
                        <td>@m.FatG.ToString("0.#")</td>
                        <td>
                            @if (editable)
                            {
                                <a asp-action="Edit" asp-route-id="@m.Id">Edit</a>
                                <form asp-action="Delete" asp-route-id="@m.Id" method="post" data-confirm="Delete this meal?">
                                    <button type="submit">Delete</button>
                                </form>
                            }
                            else { <span>Locked</span> }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
