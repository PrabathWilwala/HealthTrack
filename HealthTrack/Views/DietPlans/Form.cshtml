@model DietPlanFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    var isAdmin = User.IsInRole(RoleNames.Administrator);
    ViewData["Title"] = isEdit ? "Edit diet plan" : (isAdmin ? "New system diet template" : "New diet plan");
    var mealTypes = Enum.GetValues<MealType>();
}
<div class="page-header">
    <div>
        <a asp-action="Index" class="small fw-bold"><i class="bi bi-arrow-left"></i> Diet plans</a>
        <h1 class="page-title mt-1">@ViewData["Title"]</h1>
        <p class="page-subtitle">Meals, portions, calorie targets and nutritional guidelines.</p>
    </div>
</div>
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <div class="row g-4">
        <div class="col-xl-4">
            <div class="card-ht">
                <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-info-circle"></i>Plan details</h2></div>
                <div class="card-ht-body">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Balanced 1800 kcal" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="DailyCalorieTarget" class="form-label"></label>
                            <input asp-for="DailyCalorieTarget" class="form-control" type="number" min="800" max="6000" />
                            <div class="form-text">Meals below add up to <strong id="mealTotal">@Model.TotalMealCalories</strong> kcal.</div>
                            <span asp-validation-for="DailyCalorieTarget" class="text-danger"></span>
                        </div>
                        <div class="col-4"><label asp-for="ProteinTargetG" class="form-label">Protein (g)</label><input asp-for="ProteinTargetG" class="form-control" type="number" min="0" /></div>
                        <div class="col-4"><label asp-for="CarbsTargetG" class="form-label">Carbs (g)</label><input asp-for="CarbsTargetG" class="form-control" type="number" min="0" /></div>
                        <div class="col-4"><label asp-for="FatTargetG" class="form-label">Fat (g)</label><input asp-for="FatTargetG" class="form-control" type="number" min="0" /></div>
                    </div>
                    <div class="mt-3">
                        <label asp-for="Guidelines" class="form-label"></label>
                        <textarea asp-for="Guidelines" class="form-control" rows="3" placeholder="Hydration, foods to avoid, timing…"></textarea>
                    </div>
                    @if (!isAdmin)
                    {
                        <div class="form-check mt-3">
                            <input asp-for="IsTemplate" class="form-check-input" />
                            <label asp-for="IsTemplate" class="form-check-label"></label>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-xl-8">
            <div class="card-ht">
                <div class="card-ht-header">
                    <h2 class="card-ht-title"><i class="bi bi-egg-fried"></i>Meals</h2>
                    <button type="button" class="btn btn-light btn-sm" data-add-row="mealRows"><i class="bi bi-plus-lg"></i> Add meal</button>
                </div>
                <div class="card-ht-body" id="mealRows" data-rows="Meals" data-total-target="#mealTotal">
                    @for (var i = 0; i < Model.Meals.Count; i++)
                    {
                        var m = Model.Meals[i];
                        <div class="row-editor">
                            <button type="button" class="btn btn-light btn-sm remove-row" title="Remove"><i class="bi bi-x-lg"></i></button>
                            <div class="small-caps mb-2">Meal <span class="row-number">@(i + 1)</span></div>
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <select class="form-select" name="Meals[@i].MealType">
                                        @foreach (var t in mealTypes)
                                        {
                                            if (t == m.MealType) { <option value="@((int)t)" selected>@t</option> }
                                            else { <option value="@((int)t)">@t</option> }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6"><input class="form-control" name="Meals[@i].FoodItems" value="@m.FoodItems" maxlength="300" placeholder="Food items" required />@Html.ValidationMessage($"Meals[{i}].FoodItems", new { @class = "text-danger" })</div>
                                <div class="col-md-3"><input class="form-control" name="Meals[@i].Portion" value="@m.Portion" maxlength="100" placeholder="Portion" /></div>
                                <div class="col-3"><label class="form-text">kcal</label><input class="form-control" type="number" min="0" max="5000" name="Meals[@i].Calories" value="@m.Calories" data-sum /></div>
                                <div class="col-3"><label class="form-text">Protein g</label><input class="form-control" type="number" min="0" max="500" name="Meals[@i].ProteinG" value="@m.ProteinG" /></div>
                                <div class="col-3"><label class="form-text">Carbs g</label><input class="form-control" type="number" min="0" max="800" name="Meals[@i].CarbsG" value="@m.CarbsG" /></div>
                                <div class="col-3"><label class="form-text">Fat g</label><input class="form-control" type="number" min="0" max="300" name="Meals[@i].FatG" value="@m.FatG" /></div>
                            </div>
                        </div>
                    }
                    <template data-row-template>
                        <div class="row-editor">
                            <button type="button" class="btn btn-light btn-sm remove-row" title="Remove"><i class="bi bi-x-lg"></i></button>
                            <div class="small-caps mb-2">Meal <span class="row-number"></span></div>
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <select class="form-select" name="Meals[__i__].MealType">
                                        @foreach (var t in mealTypes) { <option value="@((int)t)">@t</option> }
                                    </select>
                                </div>
                                <div class="col-md-6"><input class="form-control" name="Meals[__i__].FoodItems" maxlength="300" placeholder="Food items" required /></div>
                                <div class="col-md-3"><input class="form-control" name="Meals[__i__].Portion" maxlength="100" placeholder="Portion" /></div>
                                <div class="col-3"><label class="form-text">kcal</label><input class="form-control" type="number" min="0" max="5000" name="Meals[__i__].Calories" value="0" data-sum /></div>
                                <div class="col-3"><label class="form-text">Protein g</label><input class="form-control" type="number" min="0" max="500" name="Meals[__i__].ProteinG" value="0" /></div>
                                <div class="col-3"><label class="form-text">Carbs g</label><input class="form-control" type="number" min="0" max="800" name="Meals[__i__].CarbsG" value="0" /></div>
                                <div class="col-3"><label class="form-text">Fat g</label><input class="form-control" type="number" min="0" max="300" name="Meals[__i__].FatG" value="0" /></div>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <a class="btn btn-light" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> @(isEdit ? "Save changes" : "Create plan")</button>
            </div>
        </div>
    </div>
</form>
