@model DietPlan
@{
    ViewData["Title"] = Model.Title;
    var canEdit = ViewData["CanEdit"] is true;
    var isTrainer = User.IsInRole(RoleNames.Trainer);
    var mealTotal = Model.Meals.Sum(m => m.Calories);
}
<div class="page-header">
    <div>
        <a asp-action="Index" class="small fw-bold"><i class="bi bi-arrow-left"></i> Diet plans</a>
        <h1 class="page-title mt-1">@Model.Title</h1>
        <p class="page-subtitle">@Model.Description</p>
    </div>
    <div class="page-actions">
        @if (isTrainer && !Model.IsTemplate && canEdit)
        {
            <a class="btn btn-teal" asp-action="Assign" asp-route-id="@Model.Id"><i class="bi bi-person-plus"></i> Assign to clients</a>
        }
        @if (isTrainer && Model.IsTemplate)
        {
            <form asp-action="UseTemplate" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary" type="submit"><i class="bi bi-files"></i> Use template</button></form>
        }
        @if (canEdit)
        {
            <a class="btn btn-light" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Delete this plan? Client assignments of this plan will also be removed.">
                <button class="btn btn-light text-danger" type="submit"><i class="bi bi-trash"></i></button>
            </form>
        }
    </div>
</div>
@if (Model.IsFlagged)
{
    <div class="alert alert-danger"><i class="bi bi-flag-fill"></i> This plan was flagged by an administrator: @Model.FlagReason</div>
}
<div class="stat-grid">
    <div class="stat-card"><div class="stat-label">Daily target</div><div class="stat-value">@Model.DailyCalorieTarget<small> kcal</small></div><div class="stat-meta">Meals total @mealTotal kcal</div></div>
    <div class="stat-card"><div class="stat-label">Protein</div><div class="stat-value">@Model.ProteinTargetG<small> g</small></div></div>
    <div class="stat-card"><div class="stat-label">Carbohydrates</div><div class="stat-value">@Model.CarbsTargetG<small> g</small></div></div>
    <div class="stat-card"><div class="stat-label">Fat</div><div class="stat-value">@Model.FatTargetG<small> g</small></div></div>
</div>
@if (!string.IsNullOrEmpty(Model.Guidelines))
{
    <div class="alert alert-info"><i class="bi bi-info-circle"></i> <strong>Guidelines:</strong> @Model.Guidelines</div>
}
<div class="card-ht">
    <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-basket"></i>Meals</h2></div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Meal</th><th>Food items</th><th>Portion</th><th>kcal</th><th>Protein</th><th>Carbs</th><th>Fat</th></tr></thead>
            <tbody>
                @foreach (var m in Model.Meals.OrderBy(m => m.SortOrder))
                {
                    <tr><td><span class="badge-soft primary">@m.MealType</span></td><td class="fw-semibold">@m.FoodItems</td><td>@m.Portion</td><td>@m.Calories</td><td>@m.ProteinG g</td><td>@m.CarbsG g</td><td>@m.FatG g</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
