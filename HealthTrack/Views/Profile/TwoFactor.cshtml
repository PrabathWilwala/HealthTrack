@model TwoFactorViewModel
@{
    ViewData["Title"] = "Two-factor authentication";
}
<div class="page-header"><div><h1 class="page-title">Profile &amp; security</h1><p class="page-subtitle">Add a second step to sign-in using an authenticator app.</p></div></div>
<partial name="_ProfileTabs" />
<div class="row"><div class="col-lg-7">
    <div class="card-ht">
        <div class="card-ht-header">
            <h2 class="card-ht-title"><i class="bi bi-shield-lock"></i>Two-factor authentication (2FA)</h2>
            @if (Model.IsEnabled) { <span class="badge-soft success"><i class="bi bi-check-circle"></i>Enabled</span> }
            else { <span class="badge-soft warning">Not enabled</span> }
        </div>
        <div class="card-ht-body">
            @if (Model.IsAdministrator && !Model.IsEnabled)
            {
                <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Administrator accounts have full system access. Multi-factor authentication is strongly recommended.</div>
            }
            @if (Model.IsEnabled)
            {
                <p>Each time you sign in you will be asked for a code from your authenticator app.</p>
                <p class="mb-3">Recovery codes left: <strong>@Model.RecoveryCodesLeft</strong>
                    @if (Model.RecoveryCodesLeft <= 3) { <span class="badge-soft danger ms-1">Generate new codes</span> }
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <form asp-action="GenerateRecoveryCodes" method="post" data-confirm="Generate new recovery codes? Your old codes will stop working.">
                        <button type="submit" class="btn btn-light"><i class="bi bi-arrow-repeat"></i> New recovery codes</button>
                    </form>
                    <form asp-action="DisableTwoFactor" method="post" data-confirm="Turn off two-factor authentication? Your account will be less secure.">
                        <button type="submit" class="btn btn-outline-danger">Turn off 2FA</button>
                    </form>
                </div>
            }
            else
            {
                <p>Protect your account even if your password is stolen. You'll need an app such as Microsoft Authenticator, Google Authenticator or Authy.</p>
                <a class="btn btn-primary" asp-action="EnableAuthenticator"><i class="bi bi-qr-code"></i> Set up authenticator app</a>
            }
        </div>
    </div>
</div></div>
