@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}
<h1>Profile &amp; security</h1>
<partial name="_ProfileTabs" />
<h2>Change password</h2>
<form asp-action="ChangePassword" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <p>
        <label asp-for="CurrentPassword"></label><br />
        <input asp-for="CurrentPassword" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword"></span>
    </p>
    <p>
        <label asp-for="NewPassword"></label><br />
        <input asp-for="NewPassword" autocomplete="new-password" />
        <span asp-validation-for="NewPassword"></span><br />
        <small>At least 8 characters including upper- and lower-case letters, a number and a symbol.</small>
    </p>
    <p>
        <label asp-for="ConfirmPassword"></label><br />
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </p>
    <button type="submit">Update password</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
