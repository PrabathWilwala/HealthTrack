@model string[]
@{
    ViewData["Title"] = "Recovery codes";
}
<div class="page-header"><div><h1 class="page-title">Save your recovery codes</h1><p class="page-subtitle">Two-factor authentication is on.</p></div></div>
<div class="row"><div class="col-lg-7">
    <div class="card-ht">
        <div class="card-ht-body">
            <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Store these codes somewhere safe. If you lose your phone, each code lets you sign in once. They will not be shown again.</div>
            <div class="row g-2 font-monospace fs-6">
                @foreach (var code in Model)
                {
                    <div class="col-6 col-md-4"><div class="border rounded-3 p-2 text-center bg-light">@code</div></div>
                }
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="button" class="btn btn-light" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
                <a class="btn btn-primary" asp-action="TwoFactor">I have saved them</a>
            </div>
        </div>
    </div>
</div></div>
