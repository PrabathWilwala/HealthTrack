@model List<ClientSummaryRow>
@{
    ViewData["Title"] = "Comparative analysis";
    var all = ViewData["AllClients"] as List<KeyValuePair<string, string>> ?? new List<KeyValuePair<string, string>>();
    var selected = ViewData["Selected"] as List<string> ?? new List<string>();
    var adherence = new ChartData { Labels = Model.Select(r => r.Name).ToList() };
    adherence.Datasets.Add(new ChartDataset { Label = "Workout adherence %", Data = Model.Select(r => r.WorkoutAdherence).ToList() });
    adherence.Datasets.Add(new ChartDataset { Label = "Diet adherence %", Data = Model.Select(r => r.DietAdherence).ToList() });
    var weight = new ChartData { Labels = Model.Select(r => r.Name).ToList() };
    weight.Datasets.Add(new ChartDataset { Label = "Weight change 30 d (kg)", Data = Model.Select(r => r.WeightChange30Days).ToList() });
    var activity = new ChartData { Labels = Model.Select(r => r.Name).ToList() };
    activity.Datasets.Add(new ChartDataset { Label = "Workouts (30 d)", Data = Model.Select(r => (decimal?)r.Workouts30Days).ToList() });
    activity.Datasets.Add(new ChartDataset { Label = "All log entries (30 d)", Data = Model.Select(r => (decimal?)r.Logs30Days).ToList() });
    var query = string.Join("&", selected.Select(s => "clientIds=" + Uri.EscapeDataString(s)));
}
<div class="page-header">
    <div>
        <a asp-action="Index" class="small fw-bold"><i class="bi bi-arrow-left"></i> Reports</a>
        <h1 class="page-title mt-1">Comparative client analysis</h1>
        <p class="page-subtitle">Compare performance across @Model.Count client(s) over the last 30 days.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-light" href="?@query&format=csv"><i class="bi bi-filetype-csv"></i> CSV</a>
        <a class="btn btn-primary" href="?@query&format=pdf"><i class="bi bi-filetype-pdf"></i> PDF</a>
    </div>
</div>
<form method="get" class="card-ht mb-4">
    <div class="card-ht-body">
        <label class="form-label">Clients to compare (none selected = all)</label>
        <div class="d-flex flex-wrap gap-3">
            @foreach (var c in all)
            {
                <label class="form-check-label d-flex align-items-center gap-1"><input class="form-check-input" type="checkbox" name="clientIds" value="@c.Key" checked="@selected.Contains(c.Key)" /> @c.Value</label>
            }
        </div>
        <button class="btn btn-light btn-sm mt-3" type="submit"><i class="bi bi-funnel"></i> Compare</button>
    </div>
</form>
<div class="row g-4">
    <div class="col-xl-6"><div class="card-ht h-100"><div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-check2-circle"></i>Adherence</h2></div><div class="card-ht-body"><div class="chart-box"><canvas data-chart="@ChartJson.Serialize(adherence)" data-type="bar" data-max="100"></canvas></div></div></div></div>
    <div class="col-xl-6"><div class="card-ht h-100"><div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-graph-down"></i>Weight change</h2></div><div class="card-ht-body"><div class="chart-box"><canvas data-chart="@ChartJson.Serialize(weight)" data-type="bar"></canvas></div></div></div></div>
    <div class="col-12"><div class="card-ht"><div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-activity"></i>Activity</h2></div><div class="card-ht-body"><div class="chart-box"><canvas data-chart="@ChartJson.Serialize(activity)" data-type="bar"></canvas></div></div></div></div>
</div>
<div class="card-ht section-gap">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Client</th><th>Weight</th><th>30 d change</th><th>BMI</th><th>Overall adh.</th><th>Workouts</th><th>Logs</th><th>Goal</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model.OrderByDescending(r => r.AdherencePercent ?? -1))
                {
                    <tr>
                        <td class="fw-bold">@r.Name</td><td>@(r.CurrentWeight?.ToString("0.0") ?? "–")</td><td>@DisplayHelpers.Signed(r.WeightChange30Days, " kg")</td>
                        <td>@(r.Bmi?.ToString("0.0") ?? "–")</td><td>@DisplayHelpers.Percent(r.AdherencePercent)</td><td>@r.Workouts30Days</td><td>@r.Logs30Days</td><td>@DisplayHelpers.Percent(r.GoalPercent)</td>
                        <td><a class="btn btn-light btn-sm" asp-action="Client" asp-route-id="@r.ClientId">Report</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
