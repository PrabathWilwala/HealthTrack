@{
    ViewData["Title"] = "Reports";
    var clients = ViewData["Clients"] as List<KeyValuePair<string, string>> ?? new List<KeyValuePair<string, string>>();
    var isAdmin = User.IsInRole(RoleNames.Administrator);
}
<h1>Reports &amp; analytics</h1>
<p>@(isAdmin ? "System-wide reports on users, trainers and routines." : "Reports on your clients' progress, engagement and routines.") Every report can be exported as PDF or CSV.</p>

<h3>Individual client report</h3>
<p>Weight, BMI, adherence, nutrition and goal progress for one client.</p>
<form method="get" asp-action="Client">
    <select name="id" required>
        <option value="">Choose client...</option>
        @foreach (var c in clients) { <option value="@c.Key">@c.Value</option> }
    </select>
    <button type="submit">Open</button>
</form>

<h3>Other reports</h3>
<ul>
    <li><a asp-action="Comparative">Comparative client analysis</a> - compare adherence, weight change and activity across clients.</li>
    <li><a asp-action="Engagement">Engagement statistics</a> - logins, log frequency, adherence and retention.</li>
    <li><a asp-action="Routines">Popular &amp; effective routines</a> - most-assigned plans and the results they produce.</li>
    <li><a asp-action="FeedbackEffectiveness">Feedback effectiveness</a> - client activity in the week before and after feedback.</li>
    @if (isAdmin)
    {
        <li><a asp-action="Overview">System performance report</a> - outcomes, trainer performance, feature usage and registrations.</li>
        <li><a asp-action="Custom">Custom report builder</a> - pick metrics, date ranges, grouping and user segments.</li>
    }
</ul>
