@model List<TrendAlert>
@{
    ViewData["Title"] = "Trend identification";
}
<p><a asp-action="Index">&lt; Reports</a></p>
<h1>Trend identification</h1>
<p>Patterns that may need proactive intervention: inactivity, falling adherence, plateaus and weight moving away from the goal.</p>
@if (Model.Count == 0)
{
    <p>No concerning trends detected. Everyone is on track!</p>
}
<ul>
    @foreach (var a in Model.OrderBy(a => a.Severity == "warning" ? 0 : 1))
    {
        <li>
            @(a.Severity == "warning" ? "[Warning]" : "[Info]") <b>@a.ClientName</b>: @a.Message
            @if (User.IsInRole(RoleNames.Trainer)) { <a href="/Trainer/Client/@a.ClientId#feedback">Give feedback</a> }
            <a asp-action="Client" asp-route-id="@a.ClientId">Report</a>
        </li>
    }
</ul>
