@model ClientPlansViewModel
@{
    ViewData["Title"] = "My plans";
    var workout = Model.WorkoutAssignment?.WorkoutPlan;
    var diet = Model.DietAssignment?.DietPlan;
    var weekStart = DateHelpers.StartOfWeek(DateTime.Today);
}
<h1>My plans</h1>
<p>Plans assigned by your trainer and how closely you're following them.</p>

<h2>Adherence</h2>
<table border="1" cellpadding="4">
    <tr><th>Workout adherence (7 d)</th><td>@DisplayHelpers.Percent(Model.Adherence7.WorkoutPercent)</td><td>@Model.Adherence7.WorkoutsCompleted of @Model.Adherence7.WorkoutsExpected.ToString("0.#") sessions</td></tr>
    <tr><th>Workout adherence (30 d)</th><td>@DisplayHelpers.Percent(Model.Adherence30.WorkoutPercent)</td><td>@Model.Adherence30.WorkoutsCompleted of @Model.Adherence30.WorkoutsExpected.ToString("0.#") sessions</td></tr>
    <tr><th>Diet adherence (30 d)</th><td>@DisplayHelpers.Percent(Model.Adherence30.DietPercent)</td><td>@Model.Adherence30.DietDaysOnTarget of @Model.Adherence30.DietDaysPlanned days within 15% of target</td></tr>
</table>

<h2>Workout plan</h2>
@if (workout == null)
{
    <p>Your trainer hasn't assigned a workout plan yet.</p>
}
else
{
    <h3>@workout.Title</h3>
    <p>@workout.Description</p>
    <ul>
        <li>Intensity: @workout.Intensity</li>
        <li>@workout.SessionsPerWeek sessions / week</li>
        <li>@workout.DurationWeeks weeks</li>
        <li>@Model.WorkoutAssignment!.StartDate.ToString("dd MMM") - @(Model.WorkoutAssignment.EndDate?.ToString("dd MMM yyyy") ?? "ongoing")</li>
        @if (!string.IsNullOrEmpty(workout.Goal)) { <li>Goal: @workout.Goal</li> }
    </ul>
    <p>This week:
        @for (var i = 0; i < 7; i++)
        {
            var day = weekStart.AddDays(i);
            var done = Model.WorkoutDaysThisWeek.TryGetValue(day.DayOfWeek, out var d) && d;
            <span>@day.ToString("ddd")@(done ? " (done)" : "")@(day == DateTime.Today ? " (today)" : "")</span>
            if (i < 6) { <text> | </text> }
        }
    </p>
    <table border="1" cellpadding="4">
        <thead><tr><th>Day</th><th>Exercise</th><th>Sets x reps</th><th>Duration</th><th>Notes</th></tr></thead>
        <tbody>
            @foreach (var e in workout.Exercises.OrderBy(x => x.SortOrder))
            {
                <tr>
                    <td>@(e.DayOfWeek?.ToString() ?? "Any day")</td>
                    <td>@e.Name</td>
                    <td>@(e.Sets > 0 ? $"{e.Sets} x {e.Reps}" : "-")</td>
                    <td>@(e.DurationMinutes > 0 ? $"{e.DurationMinutes} min" : "-")</td>
                    <td>@e.Notes</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Diet plan</h2>
@if (diet == null)
{
    <p>Your trainer hasn't assigned a diet plan yet.</p>
}
else
{
    <h3>@diet.Title</h3>
    <p>@diet.Description</p>
    <p>Daily targets: @diet.DailyCalorieTarget kcal | Protein @diet.ProteinTargetG g | Carbs @diet.CarbsTargetG g | Fat @diet.FatTargetG g</p>
    @if (!string.IsNullOrEmpty(diet.Guidelines))
    {
        <p>Guidelines: @diet.Guidelines</p>
    }
    <table border="1" cellpadding="4">
        <thead><tr><th>Meal</th><th>Food</th><th>Portion</th><th>Calories</th><th>Macros</th><th></th></tr></thead>
        <tbody>
            @foreach (var meal in diet.Meals.OrderBy(m => m.SortOrder))
            {
                <tr>
                    <td>@meal.MealType</td>
                    <td>@meal.FoodItems</td>
                    <td>@meal.Portion</td>
                    <td>@meal.Calories kcal</td>
                    <td>@($"P{meal.ProteinG} / C{meal.CarbsG} / F{meal.FatG} g")</td>
                    <td><a asp-controller="MealLogs" asp-action="Create" asp-route-fromPlanMeal="@meal.Id">Log</a></td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Plan history</h2>
@if (Model.History.Count == 0)
{
    <p>No plans assigned yet.</p>
}
else
{
    <table border="1" cellpadding="4">
        <thead><tr><th>Type</th><th>Plan</th><th>Dates</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var a in Model.History)
            {
                <tr>
                    <td>@(a.DietPlan != null ? "Diet" : "Workout")</td>
                    <td>@(a.WorkoutPlan?.Title ?? a.DietPlan?.Title)</td>
                    <td>@a.StartDate.ToString("dd MMM yyyy") - @(a.EndDate?.ToString("dd MMM yyyy") ?? "ongoing")</td>
                    <td>@(a.CoversDate(DateTime.Today) ? "Active" : "Ended")</td>
                </tr>
            }
        </tbody>
    </table>
}
