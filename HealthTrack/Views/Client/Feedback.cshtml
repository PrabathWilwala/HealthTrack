@model List<FeedbackItem>
@{
    ViewData["Title"] = "Feedback & notes";
    var notes = ViewData["Notes"] as List<Appointment> ?? new List<Appointment>();
}
<div class="page-header">
    <div>
        <h1 class="page-title">Feedback &amp; consultation notes</h1>
        <p class="page-subtitle">Comments from your trainer on your logs, and notes written after consultations.</p>
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card-ht">
            <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-chat-heart"></i>Trainer feedback</h2><span class="badge-soft">@Model.Count</span></div>
            @if (Model.Count == 0)
            {
                <div class="empty-state"><i class="bi bi-chat"></i><p>No feedback yet. Keep logging — your trainer reviews your activity regularly.</p></div>
            }
            <ul class="list-clean">
                @foreach (var item in Model)
                {
                    <li class="list-row align-items-start">
                        <span class="avatar">@DisplayHelpers.Initials(item.TrainerName)</span>
                        <div class="grow">
                            <div class="d-flex justify-content-between flex-wrap gap-2">
                                <span class="title">@item.TrainerName</span>
                                <span class="meta">@item.Feedback.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                            </div>
                            @if (item.TargetDescription != null)
                            {
                                <div class="mt-1"><span class="badge-soft primary"><i class="bi bi-link-45deg"></i>@item.TargetDescription</span></div>
                            }
                            <p class="mb-0 mt-2">@item.Feedback.Message</p>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card-ht">
            <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-journal-medical"></i>Consultation notes</h2></div>
            @if (notes.Count == 0)
            {
                <div class="empty-state"><i class="bi bi-journal"></i><p>Notes appear here after a completed consultation.</p></div>
            }
            <ul class="list-clean">
                @foreach (var a in notes)
                {
                    <li class="list-row align-items-start">
                        <div class="date-tile"><div class="d">@a.StartTime.Day</div><div class="m">@a.StartTime.ToString("MMM")</div></div>
                        <div class="grow">
                            <a class="title text-reset" asp-controller="Appointments" asp-action="Details" asp-route-id="@a.Id">@a.Purpose</a>
                            <p class="mb-0 mt-1 small" style="white-space:pre-line">@(a.ConsultationNotes ?? "No notes were added.")</p>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
