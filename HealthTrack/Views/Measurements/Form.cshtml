@model MeasurementFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit measurement" : "New measurement";
}
<h1>@ViewData["Title"]</h1>
<p>BMI is calculated automatically from your height (@Model.HeightCm.ToString("0") cm).</p>
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <p>
        <label asp-for="MeasuredOn"></label><br />
        <input asp-for="MeasuredOn" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="MeasuredOn"></span>
    </p>
    <p>
        <label asp-for="WeightKg"></label><br />
        <input asp-for="WeightKg" type="number" step="0.1" min="10" max="500" id="weightInput" />
        <span asp-validation-for="WeightKg"></span>
    </p>
    <p>
        <label for="bmiPreview">BMI (calculated)</label><br />
        <input id="bmiPreview" disabled />
    </p>
    <p>
        <label asp-for="BodyFatPercent"></label><br />
        <input asp-for="BodyFatPercent" type="number" step="0.1" />
        <span asp-validation-for="BodyFatPercent"></span>
    </p>
    <p>
        <label asp-for="WaistCm"></label><br />
        <input asp-for="WaistCm" type="number" step="0.1" />
        <span asp-validation-for="WaistCm"></span>
    </p>
    <p>
        <label asp-for="RestingHeartRate"></label><br />
        <input asp-for="RestingHeartRate" type="number" />
        <span asp-validation-for="RestingHeartRate"></span>
    </p>
    <p>
        <label asp-for="SystolicBp"></label><br />
        <input asp-for="SystolicBp" type="number" />
        <span asp-validation-for="SystolicBp"></span>
    </p>
    <p>
        <label asp-for="DiastolicBp"></label><br />
        <input asp-for="DiastolicBp" type="number" />
        <span asp-validation-for="DiastolicBp"></span>
    </p>
    <p>
        <label asp-for="Notes">Private notes</label><br />
        <textarea asp-for="Notes" rows="2" cols="60"></textarea>
        <span asp-validation-for="Notes"></span>
    </p>
    <button type="submit">Save measurement</button>
    <a asp-action="Index">Cancel</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var height = @Model.HeightCm.ToString(System.Globalization.CultureInfo.InvariantCulture) / 100;
            var input = document.getElementById('weightInput');
            var output = document.getElementById('bmiPreview');
            function update() {
                var w = parseFloat(input.value);
                output.value = height > 0 && w > 0 ? (w / (height * height)).toFixed(1) : '';
            }
            input.addEventListener('input', update);
            update();
        })();
    </script>
}
