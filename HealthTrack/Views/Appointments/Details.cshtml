@model AppointmentDetailsViewModel
@{
    var a = Model.Appointment;
    ViewData["Title"] = "Appointment details";
    var isClient = Model.Role == RoleNames.Client;
    var isTrainer = Model.Role == RoleNames.Trainer;
}
<div class="page-header">
    <div>
        <a asp-action="Index" class="small fw-bold"><i class="bi bi-arrow-left"></i> Appointments</a>
        <h1 class="page-title mt-1">@a.Purpose</h1>
        <p class="page-subtitle">@a.StartTime.ToString("dddd, dd MMMM yyyy · HH:mm") – @a.EndTime.ToString("HH:mm") (@a.DurationMinutes min)</p>
    </div>
    <div class="page-actions">
        @if (Model.CanExport)
        {
            @* <a class="btn btn-light" asp-action="Ics" asp-route-id="@a.Id"><i class="bi bi-calendar-plus"></i> Add to calendar (.ics)</a> *@
        }
        @if (Model.CanComplete)
        {
            <a class="btn btn-primary" asp-action="Complete" asp-route-id="@a.Id"><i class="bi bi-journal-check"></i> @(a.Status == AppointmentStatus.Completed ? "Edit notes" : "Complete & add notes")</a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card-ht">
            <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-info-circle"></i>Details</h2><partial name="_AppointmentStatus" model="a" /></div>
            <div class="card-ht-body">
                <dl class="kv">
                    <dt>Client</dt><dd>@Model.ClientName</dd>
                    <dt>Trainer</dt><dd>@Model.TrainerName</dd>
                    <dt>Date &amp; time</dt><dd>@a.StartTime.ToString("ddd dd MMM yyyy, HH:mm")</dd>
                    <dt>Duration</dt><dd>@a.DurationMinutes minutes</dd>
                    <dt>Requested</dt><dd>@a.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
                    @if (!string.IsNullOrEmpty(a.StatusReason))
                    {
                        <dt>@(a.Status == AppointmentStatus.Declined ? "Decline reason" : "Cancellation reason")</dt><dd>@a.StatusReason @(a.CancelledBy != null ? $"(by {a.CancelledBy.ToLowerInvariant()})" : "")</dd>
                    }
                    @if (!string.IsNullOrEmpty(a.SuggestedAlternative))
                    {
                        <dt>Suggested alternative</dt><dd>@a.SuggestedAlternative</dd>
                    }
                </dl>
            </div>
        </div>

        @if (a.Status == AppointmentStatus.Completed || !string.IsNullOrEmpty(a.ConsultationNotes))
        {
            <div class="card-ht">
                <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-journal-medical"></i>Consultation notes</h2><span class="badge-soft success"><i class="bi bi-lock-fill"></i>Encrypted</span></div>
                <div class="card-ht-body" style="white-space:pre-line">@(a.ConsultationNotes ?? "No notes were added for this consultation.")</div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        @if (a.ProposedStartTime != null)
        {
            <div class="card-ht border-info">
                <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-arrow-repeat"></i>Reschedule requested</h2></div>
                <div class="card-ht-body">
                    <p class="mb-2">The @a.RescheduleRequestedBy?.ToLowerInvariant() proposed a new time:</p>
                    <p class="fs-5 fw-bold">@a.ProposedStartTime.Value.ToString("ddd dd MMM yyyy, HH:mm")</p>
                    @if (Model.CanRespondToReschedule)
                    {
                        <div class="d-flex gap-2">
                            <form asp-action="RespondReschedule" asp-route-id="@a.Id" method="post"><input type="hidden" name="accept" value="true" /><button class="btn btn-teal" type="submit">Accept new time</button></form>
                            <form asp-action="RespondReschedule" asp-route-id="@a.Id" method="post"><input type="hidden" name="accept" value="false" /><button class="btn btn-light" type="submit">Keep original</button></form>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Waiting for the other party to respond.</p>
                    }
                </div>
            </div>
        }

        @if (Model.CanApproveOrDecline)
        {
            <div class="card-ht">
                <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-check2-square"></i>Respond to request</h2></div>
                <div class="card-ht-body">
                    <form asp-action="Approve" asp-route-id="@a.Id" method="post" class="mb-3">
                        <button class="btn btn-teal w-100" type="submit"><i class="bi bi-check2"></i> Approve this time</button>
                    </form>
                    <form asp-action="Decline" asp-route-id="@a.Id" method="post">
                        <label class="form-label" for="reason">Decline with a reason</label>
                        <textarea class="form-control mb-2" id="reason" name="reason" rows="2" maxlength="500" required placeholder="e.g. I'm fully booked that morning"></textarea>
                        <label class="form-label" for="suggestedAlternative">Suggest alternative times (optional)</label>
                        <input class="form-control mb-2" id="suggestedAlternative" name="suggestedAlternative" maxlength="200" placeholder="e.g. Tue or Thu after 2 pm" />
                        <button class="btn btn-outline-danger w-100" type="submit">Decline</button>
                    </form>
                </div>
            </div>
        }

        @if (Model.CanProposeReschedule || Model.CanCancel)
        {
            <div class="card-ht">
                <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-gear"></i>Manage</h2></div>
                <div class="card-ht-body">
                    @if (Model.CanProposeReschedule)
                    {
                        <a class="btn btn-light w-100 mb-3" asp-action="Reschedule" asp-route-id="@a.Id"><i class="bi bi-arrow-repeat"></i> Propose a new time</a>
                    }
                    @if (Model.CanCancel)
                    {
                        <form asp-action="Cancel" asp-route-id="@a.Id" method="post" data-confirm="Cancel this appointment?">
                            <label class="form-label" for="cancelReason">Cancellation reason</label>
                            <textarea class="form-control mb-2" id="cancelReason" name="reason" rows="2" maxlength="500" required></textarea>
                            @if (isClient)
                            {
                                <p class="form-text">Cancellation policy applies: approved appointments must be cancelled in advance and monthly cancellations are limited.</p>
                            }
                            <button class="btn btn-outline-danger w-100" type="submit">Cancel appointment</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>
