@model AppointmentDetailsViewModel
@{
    var a = Model.Appointment;
    ViewData["Title"] = "Appointment details";
    var isClient = Model.Role == RoleNames.Client;
    var isTrainer = Model.Role == RoleNames.Trainer;
}
<p><a asp-action="Index">&lt; Appointments</a></p>
<h1>@a.Purpose</h1>
<p>@a.StartTime.ToString("dddd, dd MMMM yyyy, HH:mm") - @a.EndTime.ToString("HH:mm") (@a.DurationMinutes min)</p>
@if (Model.CanComplete)
{
    <p><a asp-action="Complete" asp-route-id="@a.Id">@(a.Status == AppointmentStatus.Completed ? "Edit notes" : "Complete & add notes")</a></p>
}

<h2>Details</h2>
<table border="1" cellpadding="4">
    <tr><th>Status</th><td><partial name="_AppointmentStatus" model="a" /></td></tr>
    <tr><th>Client</th><td>@Model.ClientName</td></tr>
    <tr><th>Trainer</th><td>@Model.TrainerName</td></tr>
    <tr><th>Date &amp; time</th><td>@a.StartTime.ToString("ddd dd MMM yyyy, HH:mm")</td></tr>
    <tr><th>Duration</th><td>@a.DurationMinutes minutes</td></tr>
    <tr><th>Requested</th><td>@a.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td></tr>
    @if (!string.IsNullOrEmpty(a.StatusReason))
    {
        <tr><th>@(a.Status == AppointmentStatus.Declined ? "Decline reason" : "Cancellation reason")</th><td>@a.StatusReason @(a.CancelledBy != null ? $"(by {a.CancelledBy.ToLowerInvariant()})" : "")</td></tr>
    }
    @if (!string.IsNullOrEmpty(a.SuggestedAlternative))
    {
        <tr><th>Suggested alternative</th><td>@a.SuggestedAlternative</td></tr>
    }
</table>

@if (a.Status == AppointmentStatus.Completed || !string.IsNullOrEmpty(a.ConsultationNotes))
{
    <h2>Consultation notes</h2>
    <pre>@(a.ConsultationNotes ?? "No notes were added for this consultation.")</pre>
}

@if (a.ProposedStartTime != null)
{
    <h2>Reschedule requested</h2>
    <p>The @a.RescheduleRequestedBy?.ToLowerInvariant() proposed a new time: <b>@a.ProposedStartTime.Value.ToString("ddd dd MMM yyyy, HH:mm")</b></p>
    @if (Model.CanRespondToReschedule)
    {
        <form asp-action="RespondReschedule" asp-route-id="@a.Id" method="post"><input type="hidden" name="accept" value="true" /><button type="submit">Accept new time</button></form>
        <form asp-action="RespondReschedule" asp-route-id="@a.Id" method="post"><input type="hidden" name="accept" value="false" /><button type="submit">Keep original</button></form>
    }
    else
    {
        <p>Waiting for the other party to respond.</p>
    }
}

@if (Model.CanApproveOrDecline)
{
    <h2>Respond to request</h2>
    <form asp-action="Approve" asp-route-id="@a.Id" method="post">
        <button type="submit">Approve this time</button>
    </form>
    <form asp-action="Decline" asp-route-id="@a.Id" method="post">
        <p>
            <label for="reason">Decline with a reason</label><br />
            <textarea id="reason" name="reason" rows="2" cols="50" maxlength="500" required></textarea>
        </p>
        <p>
            <label for="suggestedAlternative">Suggest alternative times (optional)</label><br />
            <input id="suggestedAlternative" name="suggestedAlternative" maxlength="200" size="50" />
        </p>
        <button type="submit">Decline</button>
    </form>
}

@if (Model.CanProposeReschedule || Model.CanCancel)
{
    <h2>Manage</h2>
    @if (Model.CanProposeReschedule)
    {
        <p><a asp-action="Reschedule" asp-route-id="@a.Id">Propose a new time</a></p>
    }
    @if (Model.CanCancel)
    {
        <form asp-action="Cancel" asp-route-id="@a.Id" method="post" data-confirm="Cancel this appointment?">
            <p>
                <label for="cancelReason">Cancellation reason</label><br />
                <textarea id="cancelReason" name="reason" rows="2" cols="50" maxlength="500" required></textarea>
            </p>
            @if (isClient)
            {
                <p><small>Cancellation policy applies: approved appointments must be cancelled in advance and monthly cancellations are limited.</small></p>
            }
            <button type="submit">Cancel appointment</button>
        </form>
    }
}
