@model AppointmentRequestViewModel
@{
    ViewData["Title"] = "Request an appointment";
}
<p><a asp-action="Index">&lt; Appointments</a></p>
<h1>Request a consultation</h1>
<p>Choose a trainer or healthcare professional and a time within their availability.</p>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    @if (Model.Trainers.Count == 0)
    {
        <p><b>No approved trainers are available yet.</b></p>
    }
    <p>
        <label asp-for="TrainerId"></label><br />
        <select asp-for="TrainerId" id="trainerSelect">
            <option value="">Choose...</option>
            @foreach (var t in Model.Trainers)
            {
                <option value="@t.UserId">@($"{t.FullName} - {t.Specializations}{(t.UserId == Model.AssignedTrainerId ? " (your trainer)" : "")}")</option>
            }
        </select>
        <span asp-validation-for="TrainerId"></span>
    </p>
    <p>
        <label asp-for="StartTime"></label><br />
        <input asp-for="StartTime" type="datetime-local" step="900" />
        <span asp-validation-for="StartTime"></span>
    </p>
    <p>
        <label asp-for="DurationMinutes"></label><br />
        <select asp-for="DurationMinutes">
            <option value="15">15 minutes</option>
            <option value="30">30 minutes</option>
            <option value="45">45 minutes</option>
            <option value="60">60 minutes</option>
            <option value="90">90 minutes</option>
        </select>
    </p>
    <p>
        <label asp-for="Purpose"></label><br />
        <textarea asp-for="Purpose" rows="3" cols="60"></textarea>
        <span asp-validation-for="Purpose"></span>
    </p>
    <button type="submit">Send request</button>
    <a asp-action="Index">Cancel</a>
</form>

<h3>Weekly availability</h3>
@foreach (var t in Model.Trainers)
{
    <div data-availability data-trainer="@t.UserId">
        <p><b>@t.FullName</b></p>
        @if (Model.Availability.TryGetValue(t.UserId, out var slots) && slots.Count > 0)
        {
            <ul>
                @foreach (var slot in slots) { <li>@slot</li> }
            </ul>
        }
        else
        {
            <p>No fixed hours published - any time can be requested.</p>
        }
    </div>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var select = document.getElementById('trainerSelect');
            function update() {
                document.querySelectorAll('[data-availability]').forEach(function (b) {
                    b.hidden = select.value && b.getAttribute('data-trainer') !== select.value;
                });
            }
            select.addEventListener('change', update);
            update();
        })();
    </script>
}
