@{
    ViewData["Title"] = "Personal health & fitness management";
}
<h1>Welcome to HealthTrack</h1>
<p>HealthTrack brings clients, trainers and administrators together: personalised workout and diet plans, simple logging, consultations and analytics.</p>
<p>
    <a asp-controller="Account" asp-action="Register">Create a free account</a> |
    <a asp-controller="Account" asp-action="Login">Sign in</a>
</p>

<h3>For clients</h3>
<p>Log workouts, meals and measurements, follow your trainer's plans, book consultations and watch your weight, BMI and calories trend over time.</p>

<h3>For trainers</h3>
<p>Build personalised plans from templates, monitor adherence, give feedback on client logs, manage your calendar and export progress reports.</p>

<h3>For administrators</h3>
<p>Approve trainers, assign clients, oversee plans and appointments, broadcast announcements and analyse engagement across the platform.</p>
