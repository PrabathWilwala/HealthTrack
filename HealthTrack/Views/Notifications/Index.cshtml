@model NotificationCenterViewModel
@{
    ViewData["Title"] = "Notifications";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Notification centre</h1>
        <p class="page-subtitle">@Model.UnreadCount unread · reminders, plan updates, feedback, appointments and announcements.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-light" asp-action="Preferences"><i class="bi bi-sliders"></i> Preferences</a>
        @if (Model.UnreadCount > 0)
        {
            <form asp-action="MarkAllRead" method="post"><button class="btn btn-primary" type="submit"><i class="bi bi-check2-all"></i> Mark all as read</button></form>
        }
    </div>
</div>
<div class="card-ht">
    <div class="card-ht-header">
        <ul class="nav nav-tabs border-0">
            <li class="nav-item"><a class="nav-link @(Model.Filter == "all" ? "active" : "")" asp-route-filter="all" asp-route-type="@Model.Type">All</a></li>
            <li class="nav-item"><a class="nav-link @(Model.Filter == "unread" ? "active" : "")" asp-route-filter="unread" asp-route-type="@Model.Type">Unread <span class="badge-soft primary">@Model.UnreadCount</span></a></li>
        </ul>
        <form method="get">
            <input type="hidden" name="filter" value="@Model.Filter" />
            <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All types</option>
                @foreach (var t in Enum.GetValues<NotificationType>())
                {
                    if (Model.Type == t) { <option value="@t" selected>@t</option> } else { <option value="@t">@t</option> }
                }
            </select>
        </form>
    </div>
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-bell-slash"></i><p>No notifications here.</p></div>
    }
    <ul class="list-clean">
        @foreach (var n in Model.Items)
        {
            <li class="list-row @(n.IsRead ? "" : "bg-light")">
                <span class="icon-bubble @(n.Type == NotificationType.SecurityAlert || n.Type == NotificationType.AdherenceAlert ? "rose" : n.Type == NotificationType.Broadcast ? "amber" : "")"><i class="bi @DisplayHelpers.NotificationIcon(n.Type)"></i></span>
                <div class="grow">
                    <div class="title">@if (!n.IsRead) { <span class="status-dot text-primary me-1"></span> }@n.Title</div>
                    <div class="small">@n.Message</div>
                    <div class="meta">@DateHelpers.TimeAgo(n.CreatedAtUtc) · @n.Type</div>
                </div>
                <div class="d-flex gap-1">
                    @if (!string.IsNullOrEmpty(n.LinkUrl))
                    {
                        <form asp-action="Open" asp-route-id="@n.Id" method="post"><button class="btn btn-light btn-sm" type="submit">Open</button></form>
                    }
                    <form asp-action="MarkRead" asp-route-id="@n.Id" method="post">
                        <input type="hidden" name="read" value="@(n.IsRead ? "false" : "true")" />
                        <button class="btn btn-light btn-sm" type="submit" title="@(n.IsRead ? "Mark as unread" : "Mark as read")"><i class="bi @(n.IsRead ? "bi-envelope" : "bi-envelope-open")"></i></button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@n.Id" method="post"><button class="btn btn-light btn-sm" type="submit" title="Delete"><i class="bi bi-trash"></i></button></form>
                </div>
            </li>
        }
    </ul>
    @if (Model.TotalPages > 1)
    {
        <div class="card-ht-footer d-flex justify-content-between align-items-center">
            <span class="small text-muted">Page @Model.Page of @Model.TotalPages</span>
            <div class="btn-group">
                @if (Model.Page > 1) { <a class="btn btn-light btn-sm" asp-route-page="@(Model.Page - 1)" asp-route-filter="@Model.Filter" asp-route-type="@Model.Type">Previous</a> }
                @if (Model.Page < Model.TotalPages) { <a class="btn btn-light btn-sm" asp-route-page="@(Model.Page + 1)" asp-route-filter="@Model.Filter" asp-route-type="@Model.Type">Next</a> }
            </div>
        </div>
    }
</div>
