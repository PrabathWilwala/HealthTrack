@model NotificationPreferencesViewModel
@{
    ViewData["Title"] = "Notification preferences";
    var isClient = Model.Role == RoleNames.Client;
    var isTrainer = Model.Role == RoleNames.Trainer;
    var isAdmin = Model.Role == RoleNames.Administrator;
}
<h1>Notification preferences</h1>
<p>Choose what you're notified about and how. Security alerts and announcements are always delivered.</p>
<form asp-action="Preferences" method="post">
    <h3>Channels</h3>
    <p>
        <input asp-for="EmailNotifications" />
        <label asp-for="EmailNotifications"></label><br />
        <small>In-app notifications are always on. Email requires SMTP to be configured by the administrator.</small>
    </p>

    <h3>What to notify me about</h3>
    @if (isClient)
    {
        <p>
            <input asp-for="WorkoutReminders" />
            <label asp-for="WorkoutReminders"></label>
            - <label for="WorkoutReminderTime">Remind me after</label>
            <input type="time" id="WorkoutReminderTime" name="WorkoutReminderTime" value="@Model.WorkoutReminderTime.ToString("hh\\:mm")" />
        </p>
        <p>
            <input asp-for="MealReminders" />
            <label asp-for="MealReminders"></label>
            - <label for="MealReminderTime">Remind me after</label>
            <input type="time" id="MealReminderTime" name="MealReminderTime" value="@Model.MealReminderTime.ToString("hh\\:mm")" />
        </p>
        <p><input asp-for="PlanUpdates" /> <label asp-for="PlanUpdates"></label></p>
        <p><input asp-for="FeedbackAlerts" /> <label asp-for="FeedbackAlerts"></label></p>
    }
    else
    {
        <input type="hidden" name="WorkoutReminders" value="@Model.WorkoutReminders.ToString().ToLower()" />
        <input type="hidden" name="MealReminders" value="@Model.MealReminders.ToString().ToLower()" />
        <input type="hidden" name="PlanUpdates" value="@Model.PlanUpdates.ToString().ToLower()" />
        <input type="hidden" name="FeedbackAlerts" value="@Model.FeedbackAlerts.ToString().ToLower()" />
        <input type="hidden" name="WorkoutReminderTime" value="@Model.WorkoutReminderTime.ToString("hh\\:mm")" />
        <input type="hidden" name="MealReminderTime" value="@Model.MealReminderTime.ToString("hh\\:mm")" />
    }
    <p>
        <input asp-for="AppointmentAlerts" />
        <label asp-for="AppointmentAlerts"></label>
        <small>(includes reminders 24 hours and 1 hour before)</small>
    </p>
    @if (isTrainer)
    {
        <p>
            <input asp-for="AdherenceAlerts" />
            <label asp-for="AdherenceAlerts"></label>
            <small>(when a client's weekly adherence falls below the threshold)</small>
        </p>
        <p>
            <label asp-for="ClientLogAlerts"></label><br />
            <select asp-for="ClientLogAlerts" asp-items="Html.GetEnumSelectList<ClientLogAlertFrequency>()"></select>
            <small>Get notified when clients log workouts, meals or measurements.</small>
        </p>
    }
    else
    {
        <input type="hidden" name="AdherenceAlerts" value="@Model.AdherenceAlerts.ToString().ToLower()" />
        <input type="hidden" name="ClientLogAlerts" value="@((int)Model.ClientLogAlerts)" />
    }
    @if (isAdmin || isTrainer)
    {
        <p><input asp-for="SystemAlerts" /> <label asp-for="SystemAlerts"></label></p>
    }
    else
    {
        <input type="hidden" name="SystemAlerts" value="@Model.SystemAlerts.ToString().ToLower()" />
    }
    <button type="submit">Save preferences</button>
</form>
