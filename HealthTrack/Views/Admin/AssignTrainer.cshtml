@model AssignTrainerViewModel
@{
    ViewData["Title"] = "Assign trainer";
}
<p><a asp-action="Users" asp-route-role="Client">&lt; Clients</a></p>
<h1>Assign a trainer to @Model.ClientName</h1>
<p>Goals: @(Model.FitnessGoals ?? "not specified"). Trainers whose specialisations match are marked as a good match.</p>
<form asp-action="AssignTrainer" method="post">
    <input type="hidden" asp-for="ClientId" />
    <table border="1" cellpadding="4">
        <thead><tr><th>Select</th><th>Trainer</th><th>Specialisations</th><th>Current clients</th><th>Notes</th></tr></thead>
        <tbody>
            <tr>
                <td><input type="radio" name="TrainerId" value="" id="t_none" checked="@(Model.CurrentTrainerId == null)" /></td>
                <td colspan="4"><label for="t_none">No trainer</label></td>
            </tr>
            @foreach (var t in Model.Trainers.OrderByDescending(t => Model.SuggestedTrainerIds.Contains(t.UserId)).ThenBy(t => t.ClientCount))
            {
                var suggested = Model.SuggestedTrainerIds.Contains(t.UserId);
                <tr>
                    <td><input type="radio" name="TrainerId" value="@t.UserId" id="@("t" + t.UserId)" checked="@(t.UserId == Model.CurrentTrainerId)" /></td>
                    <td><label for="@("t" + t.UserId)">@t.FullName</label></td>
                    <td>@t.Specializations</td>
                    <td>@t.ClientCount</td>
                    <td>@if (suggested) { <span>Good match</span> }
                        @if (t.UserId == Model.CurrentTrainerId) { <span>Current</span> }</td>
                </tr>
            }
        </tbody>
    </table>
    <p><button type="submit">Save assignment</button></p>
</form>
