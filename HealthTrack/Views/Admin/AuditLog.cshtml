@model AuditLogViewModel
@{
    ViewData["Title"] = "Audit log";
}
<h1>Audit log</h1>
<p>Security-relevant events, data access and administrative actions.</p>
<form method="get">
    <input type="search" name="search" value="@Model.Search" />
    <select name="category">
        <option value="">All areas</option>
        @foreach (var c in Model.Categories)
        {
            if (c == Model.Category) { <option selected>@c</option> } else { <option>@c</option> }
        }
    </select>
    <input type="checkbox" name="securityOnly" value="true" id="securityOnly" checked="@Model.SecurityOnly" />
    <label for="securityOnly">Security events only</label>
    <button type="submit">Filter</button>
</form>
<p>@Model.TotalCount event(s)</p>
@if (Model.Entries.Count == 0)
{
    <p>No events match.</p>
}
else
{
    <table border="1" cellpadding="4">
        <thead><tr><th>When</th><th>User</th><th>Area</th><th>Action</th><th>Details</th><th>IP address</th></tr></thead>
        <tbody>
            @foreach (var e in Model.Entries)
            {
                <tr>
                    <td>@e.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td>
                    <td>@(e.UserName ?? "-")</td>
                    <td>@e.Category</td>
                    <td>@e.Action@(e.IsSecurityEvent ? " (security)" : "")</td>
                    <td>@e.Details</td>
                    <td>@e.IpAddress</td>
                </tr>
            }
        </tbody>
    </table>
}
@if (Model.TotalPages > 1)
{
    <p>
        Page @Model.Page of @Model.TotalPages
        @if (Model.Page > 1) { <a asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-category="@Model.Category" asp-route-securityOnly="@Model.SecurityOnly">Previous</a> }
        @if (Model.Page < Model.TotalPages) { <a asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-category="@Model.Category" asp-route-securityOnly="@Model.SecurityOnly">Next</a> }
    </p>
}
