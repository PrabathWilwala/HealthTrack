@model UserListViewModel
@{
    ViewData["Title"] = "User management";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var myId = User.GetUserId();
}
<div class="page-header">
    <div>
        <h1 class="page-title">Users</h1>
        <p class="page-subtitle">Browse, search and manage every client, trainer and administrator account.</p>
    </div>
    <div class="page-actions"><a class="btn btn-primary" asp-action="CreateUser"><i class="bi bi-person-plus"></i> Create user</a></div>
</div>
<div class="card-ht">
    <div class="card-ht-header">
        <form method="get" class="filter-bar">
            <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Name, username or email" />
            <select name="role" class="form-select">
                <option value="">All roles</option>
                @foreach (var r in RoleNames.All)
                {
                    if (r == Model.Role) { <option selected>@r</option> } else { <option>@r</option> }
                }
            </select>
            <select name="status" class="form-select">
                @foreach (var (value, text) in new[] { ("", "Any status"), ("active", "Active"), ("deactivated", "Deactivated"), ("pending", "Awaiting approval"), ("unconfirmed", "Email not confirmed"), ("unassigned", "Clients without trainer") })
                {
                    if (value == (Model.Status ?? "")) { <option value="@value" selected>@text</option> } else { <option value="@value">@text</option> }
                }
            </select>
            <button class="btn btn-light" type="submit"><i class="bi bi-funnel"></i> Filter</button>
        </form>
        <span class="small text-muted">@Model.TotalCount user(s)</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>User</th><th>Role</th><th>Status</th><th>Trainer</th><th>Last active</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td><div class="d-flex align-items-center gap-2"><span class="avatar">@DisplayHelpers.Initials(u.FullName)</span><div><div class="fw-bold">@u.FullName</div><div class="small text-muted">@u.UserName · @u.Email</div></div></div></td>
                        <td><span class="badge-soft @(u.Role == RoleNames.Administrator ? "dark" : u.Role == RoleNames.Trainer ? "teal" : "primary")">@u.Role</span></td>
                        <td>
                            @if (u.IsDeactivated) { <span class="badge-soft danger">Deactivated</span> }
                            else if (u.IsLockedOut) { <span class="badge-soft warning">Locked out</span> }
                            else { <span class="badge-soft success">Active</span> }
                            @if (!u.EmailConfirmed) { <span class="badge-soft warning">Email unconfirmed</span> }
                            @if (u.TrainerApproved == false && !u.TrainerRejected) { <span class="badge-soft warning">Awaiting approval</span> }
                            @if (u.TrainerRejected) { <span class="badge-soft danger">Rejected</span> }
                        </td>
                        <td class="small">
                            @if (u.Role == RoleNames.Client)
                            {
                                <a asp-action="AssignTrainer" asp-route-id="@u.Id">@(u.AssignedTrainer ?? "Assign…")</a>
                            }
                            else { <span class="text-muted">–</span> }
                        </td>
                        <td class="small text-muted">@(u.LastActiveUtc.HasValue ? DateHelpers.TimeAgo(u.LastActiveUtc.Value) : "never")</td>
                        <td class="text-end text-nowrap">
                            @if (u.TrainerApproved == false)
                            {
                                <form asp-action="ApproveTrainer" asp-route-id="@u.Id" method="post" class="d-inline"><input type="hidden" name="returnUrl" value="@currentUrl" /><button class="btn btn-teal btn-sm" type="submit">Approve</button></form>
                                if (!u.TrainerRejected)
                                {
                                    <form asp-action="RejectTrainer" asp-route-id="@u.Id" method="post" class="d-inline" data-confirm="Reject this trainer application?"><input type="hidden" name="returnUrl" value="@currentUrl" /><button class="btn btn-light btn-sm" type="submit">Reject</button></form>
                                }
                            }
                            <div class="dropdown d-inline">
                                <button class="btn btn-light btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">Manage</button>
                                <ul class="dropdown-menu dropdown-menu-end SPclass">
                                    <li><a class="dropdown-item" asp-action="EditUser" asp-route-id="@u.Id"><i class="bi bi-pencil me-2"></i>Edit details</a></li>
                                    <li><a class="dropdown-item" asp-action="UserActivity" asp-route-id="@u.Id"><i class="bi bi-clock-history me-2"></i>Activity log</a></li>
                                    @if (u.Role == RoleNames.Client)
                                    {
                                        <li><a class="dropdown-item" asp-action="AssignTrainer" asp-route-id="@u.Id"><i class="bi bi-diagram-3 me-2"></i>Assign trainer</a></li>
                                        <li><a class="dropdown-item" asp-controller="Reports" asp-action="Client" asp-route-id="@u.Id"><i class="bi bi-file-earmark-bar-graph me-2"></i>Progress report</a></li>
                                    }
                                    @if (u.Id != myId)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" data-confirm="@(u.IsDeactivated ? "Reactivate this account?" : "Deactivate this account? The user will be signed out.")">
                                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                <button class="dropdown-item" type="submit"><i class="bi @(u.IsDeactivated ? "bi-play-circle" : "bi-pause-circle") me-2"></i>@(u.IsDeactivated ? "Reactivate" : "Deactivate")</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" data-confirm="Permanently delete @u.UserName and ALL of their data? This cannot be undone.">
                                                <button class="dropdown-item text-danger" type="submit"><i class="bi bi-trash me-2"></i>Delete account</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Users.Count == 0) { <div class="empty-state"><i class="bi bi-people"></i><p>No users match these filters.</p></div> }
    @if (Model.TotalPages > 1)
    {
        <div class="card-ht-footer">
            <nav><ul class="pagination pagination-sm mb-0 justify-content-center">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-role="@Model.Role" asp-route-status="@Model.Status">@p</a></li>
                }
            </ul></nav>
        </div>
    }
</div>
