@model AdminPlansViewModel
@{
    ViewData["Title"] = "Plan oversight";
}
<div class="page-header">
    <div>
        <h1 class="page-title">All workout &amp; diet plans</h1>
        <p class="page-subtitle">Review plans for quality and compliance, flag or remove inappropriate content, and see what's popular.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-light" asp-controller="WorkoutPlans" asp-action="Index"><i class="bi bi-collection"></i> Workout templates</a>
        <a class="btn btn-light" asp-controller="DietPlans" asp-action="Index"><i class="bi bi-basket"></i> Diet templates</a>
    </div>
</div>

@if (Model.Popular.Count > 0)
{
    <div class="stat-grid">
        @foreach (var p in Model.Popular)
        {
            <div class="stat-card">
                <div class="stat-label">@p.PlanType</div>
                <div class="fw-bold mt-1">@p.Title</div>
                <div class="stat-meta">Assigned @p.TimesAssigned× · adherence @DisplayHelpers.Percent(p.AverageAdherence)</div>
            </div>
        }
    </div>
}

<div class="card-ht">
    <div class="card-ht-header">
        <ul class="nav nav-tabs border-0">
            @foreach (var (value, text) in new[] { ("", "All"), ("workout", "Workout"), ("diet", "Diet"), ("templates", "Templates"), ("flagged", "Flagged") })
            {
                <li class="nav-item"><a class="nav-link @((Model.Filter ?? "") == value ? "active" : "")" asp-route-filter="@value">@text</a></li>
            }
        </ul>
        <input type="search" class="form-control form-control-sm" style="max-width:240px" placeholder="Filter…" data-table-filter="#planTable" />
    </div>
    <div class="table-responsive">
        <table class="table table-hover" id="planTable">
            <thead><tr><th>Plan</th><th>Type</th><th>Created by</th><th>Items</th><th>Assigned</th><th>Updated</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Plans)
                {
                    var controller = p.Type == "Workout" ? "WorkoutPlans" : "DietPlans";
                    <tr class="@(p.IsFlagged ? "table-danger" : "")">
                        <td>
                            <a class="fw-bold text-reset" asp-controller="@controller" asp-action="Details" asp-route-id="@p.Id">@p.Title</a>
                            @if (p.IsSystemTemplate) { <span class="badge-soft dark ms-1">System</span> }
                            else if (p.IsTemplate) { <span class="badge-soft primary ms-1">Template</span> }
                            @if (p.IsFlagged) { <div class="small text-danger"><i class="bi bi-flag-fill"></i> @p.FlagReason</div> }
                        </td>
                        <td><span class="badge-soft @(p.Type == "Diet" ? "teal" : "primary")">@p.Type</span></td>
                        <td>@p.CreatedBy</td>
                        <td>@p.Items</td>
                        <td>@p.TimesAssigned</td>
                        <td class="small text-muted">@DateHelpers.TimeAgo(p.UpdatedAtUtc)</td>
                        <td class="text-end text-nowrap">
                            @if (p.IsFlagged)
                            {
                                <form asp-action="FlagPlan" method="post" class="d-inline">
                                    <input type="hidden" name="type" value="@p.Type" /><input type="hidden" name="id" value="@p.Id" /><input type="hidden" name="flag" value="false" />
                                    <button class="btn btn-light btn-sm" type="submit">Clear flag</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="@("#flag-" + p.Type + "-" + p.Id)"><i class="bi bi-flag"></i> Flag</button>
                            }
                            <form asp-action="DeletePlan" method="post" class="d-inline" data-confirm="Remove this plan? Assignments to clients will also be removed.">
                                <input type="hidden" name="type" value="@p.Type" /><input type="hidden" name="id" value="@p.Id" />
                                <button class="btn btn-light btn-sm text-danger" type="submit"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    if (!p.IsFlagged)
                    {
                        <tr class="collapse" id="@("flag-" + p.Type + "-" + p.Id)">
                            <td colspan="7">
                                <form asp-action="FlagPlan" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="type" value="@p.Type" /><input type="hidden" name="id" value="@p.Id" /><input type="hidden" name="flag" value="true" />
                                    <input class="form-control form-control-sm" name="reason" maxlength="500" placeholder="Reason (e.g. unsafe calorie target, inappropriate content)" required />
                                    <button class="btn btn-danger btn-sm" type="submit">Flag plan</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.Plans.Count == 0) { <div class="empty-state"><p>No plans found.</p></div> }
</div>
