@model EditUserViewModel
@{
    ViewData["Title"] = "Edit user";
    var isSelf = Model.Id == User.GetUserId();
}
<div class="page-header">
    <div>
        <a asp-action="Users" class="small fw-bold"><i class="bi bi-arrow-left"></i> Users</a>
        <h1 class="page-title mt-1">@Model.FullName</h1>
        <p class="page-subtitle">@Model.CurrentRole · @(Model.IsDeactivated ? "Deactivated" : "Active") · 2FA @(Model.TwoFactorEnabled ? "on" : "off")</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-light" asp-action="UserActivity" asp-route-id="@Model.Id"><i class="bi bi-clock-history"></i> Activity log</a>
    </div>
</div>
<div class="row g-4">
    <div class="col-xl-7">
        <form asp-action="EditUser" method="post" class="card-ht">
            <input type="hidden" asp-for="Id" />
            <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-person-gear"></i>Account details</h2></div>
            <div class="card-ht-body">
                <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="UserName" class="form-label"></label><input asp-for="UserName" class="form-control" /><span asp-validation-for="UserName" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label"></label>
                        @if (isSelf)
                        {
                            <input class="form-control" value="@Model.CurrentRole" disabled />
                            <input type="hidden" name="Role" value="@Model.CurrentRole" />
                            <div class="form-text">You cannot change your own role.</div>
                        }
                        else
                        {
                            <select asp-for="Role" class="form-select">
                                <option>@RoleNames.Client</option>
                                <option>@RoleNames.Trainer</option>
                                <option>@RoleNames.Administrator</option>
                            </select>
                            <div class="form-text">Changing a role signs the user out of their current session.</div>
                        }
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check"><input asp-for="EmailConfirmed" class="form-check-input" /><label asp-for="EmailConfirmed" class="form-check-label"></label></div>
                    </div>
                </div>
            </div>
            <div class="card-ht-footer text-end"><button type="submit" class="btn btn-primary">Save changes</button></div>
        </form>
    </div>
    <div class="col-xl-5">
        <div class="card-ht">
            <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-key"></i>Password</h2></div>
            <div class="card-ht-body">
                <form asp-action="SendPasswordReset" asp-route-id="@Model.Id" method="post" class="mb-3">
                    <button type="submit" class="btn btn-light w-100"><i class="bi bi-envelope"></i> Email a password reset link</button>
                </form>
                <form asp-action="SetPassword" method="post">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <label class="form-label" for="NewPassword">Or set a new password</label>
                    <input class="form-control mb-2" type="password" id="NewPassword" name="NewPassword" minlength="8" required autocomplete="new-password" />
                    <button type="submit" class="btn btn-outline-primary w-100">Set password</button>
                </form>
            </div>
        </div>
        @if (!isSelf)
        {
            <div class="card-ht">
                <div class="card-ht-header"><h2 class="card-ht-title"><i class="bi bi-exclamation-octagon"></i>Account status</h2></div>
                <div class="card-ht-body d-flex flex-column gap-2">
                    <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" name="returnUrl" value="@Url.Action("EditUser", new { id = Model.Id })" />
                        <button type="submit" class="btn btn-light w-100">@(Model.IsDeactivated ? "Reactivate account" : "Deactivate account")</button>
                    </form>
                    <form asp-action="DeleteUser" asp-route-id="@Model.Id" method="post" data-confirm="Permanently delete this account and ALL associated data?">
                        <button type="submit" class="btn btn-outline-danger w-100">Delete account and data</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
