@model CreateUserViewModel
@{
    ViewData["Title"] = "Create user";
}
<p><a asp-action="Users">&lt; Users</a></p>
<h1>Create a user account</h1>
<p>Administrator-created accounts are confirmed immediately. Trainers created here are pre-approved.</p>
<form asp-action="CreateUser" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <p>
        <label asp-for="Role"></label><br />
        <select asp-for="Role" data-toggle-sections>
            <option>@RoleNames.Client</option>
            <option>@RoleNames.Trainer</option>
            <option>@RoleNames.Administrator</option>
        </select>
    </p>
    <p><label asp-for="FullName"></label><br /><input asp-for="FullName" /><span asp-validation-for="FullName"></span></p>
    <p><label asp-for="UserName"></label><br /><input asp-for="UserName" autocomplete="off" /><span asp-validation-for="UserName"></span></p>
    <p><label asp-for="Email"></label><br /><input asp-for="Email" autocomplete="off" /><span asp-validation-for="Email"></span></p>
    <p><label asp-for="Password"></label><br /><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span></p>

    <div data-section="Client">
        <h3>Client profile</h3>
        <p><label asp-for="Age"></label><br /><input asp-for="Age" type="number" /><span asp-validation-for="Age"></span></p>
        <p><label asp-for="Gender"></label><br />
            <select asp-for="Gender"><option value="">Select...</option><option>Female</option><option>Male</option><option>Non-binary</option><option>Other</option><option>Prefer not to say</option></select>
            <span asp-validation-for="Gender"></span></p>
        <p><label asp-for="HeightCm"></label><br /><input asp-for="HeightCm" type="number" step="0.1" /><span asp-validation-for="HeightCm"></span></p>
        <p><label asp-for="WeightKg"></label><br /><input asp-for="WeightKg" type="number" step="0.1" /><span asp-validation-for="WeightKg"></span></p>
        <p><label asp-for="FitnessGoals"></label><br /><textarea asp-for="FitnessGoals" rows="2" cols="60"></textarea></p>
    </div>
    <div data-section="Trainer">
        <h3>Trainer profile</h3>
        <p><label asp-for="Qualifications"></label><br /><textarea asp-for="Qualifications" rows="2" cols="60"></textarea><span asp-validation-for="Qualifications"></span></p>
        <p><label asp-for="Specializations"></label><br /><textarea asp-for="Specializations" rows="2" cols="60"></textarea><span asp-validation-for="Specializations"></span></p>
    </div>
    <button type="submit">Create account</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
