@model List<NotificationTemplate>
@{
    ViewData["Title"] = "Notification templates";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Notification templates</h1>
        <p class="page-subtitle">Edit the wording of automated notifications. Tokens such as {ClientName} are replaced automatically.</p>
    </div>
</div>
<div class="card-ht">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Template</th><th>Title</th><th>Message</th><th>Updated</th><th></th></tr></thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td><div class="fw-semibold">@t.Name</div><code class="small">@t.Key</code></td>
                        <td class="small">@t.TitleTemplate</td>
                        <td class="small text-muted">@t.BodyTemplate</td>
                        <td class="small text-muted text-nowrap">@DateHelpers.TimeAgo(t.UpdatedAtUtc)</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-light btn-sm" asp-action="EditTemplate" asp-route-id="@t.Id"><i class="bi bi-pencil"></i></a>
                            <form asp-action="ResetTemplate" asp-route-id="@t.Id" method="post" class="d-inline" data-confirm="Restore the default text?"><button class="btn btn-light btn-sm" type="submit" title="Restore default"><i class="bi bi-arrow-counterclockwise"></i></button></form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
