@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}
<h1>Forgot your password?</h1>
<p>Enter the email address on your account and we will send you a secure reset link (valid for 3 hours).</p>
<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <p>
        <label asp-for="Email">Email address</label><br />
        <input asp-for="Email" autocomplete="email" autofocus />
        <span asp-validation-for="Email"></span>
    </p>
    <button type="submit">Send reset link</button>
</form>
<p><a asp-action="Login">Back to sign in</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
