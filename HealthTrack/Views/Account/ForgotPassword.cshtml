@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<div class="ht-auth-page">
    <section class="ht-auth-card">
        <partial name="_AuthBrand" />
        <header class="ht-auth-heading">
            <p class="ht-eyebrow">PASSWORD RESET</p>
            <h1>Forgot your password?</h1>
            <p>Enter the email address on your account and we will send you a secure reset link (valid for 3 hours).</p>
        </header>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="ht-validation-summary" role="alert"></div>
            <div class="ht-field">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email" class="ht-control" autocomplete="email" placeholder="you@example.com" autofocus />
                <span asp-validation-for="Email" class="ht-field-error"></span>
            </div>
            <button type="submit" class="ht-primary-button">Send reset link <span aria-hidden="true">&#8594;</span></button>
            <p class="ht-auth-switch"><a asp-action="Login">Back to sign in</a></p>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
