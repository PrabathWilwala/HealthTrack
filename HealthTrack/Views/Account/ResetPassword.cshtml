@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a new password";
}
<h1>Choose a new password</h1>
<p>Use at least 8 characters with upper- and lower-case letters, a number and a symbol.</p>
<form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <input asp-for="UserId" type="hidden" />
    <input asp-for="Code" type="hidden" />
    <p>
        <label asp-for="Password">New password</label><br />
        <input asp-for="Password" autocomplete="new-password" autofocus />
        <span asp-validation-for="Password"></span>
    </p>
    <p>
        <label asp-for="ConfirmPassword">Confirm new password</label><br />
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </p>
    <button type="submit">Reset password</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
