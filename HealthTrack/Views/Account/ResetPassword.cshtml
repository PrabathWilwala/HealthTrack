@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a new password";
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<div class="ht-auth-page">
    <section class="ht-auth-card">
        <partial name="_AuthBrand" />
        <header class="ht-auth-heading">
            <p class="ht-eyebrow">PASSWORD RESET</p>
            <h1>Choose a new password</h1>
            <p>Use at least 8 characters with upper- and lower-case letters, a number and a symbol.</p>
        </header>
        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="ht-validation-summary" role="alert"></div>
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Code" type="hidden" />
            <div class="ht-field">
                <label asp-for="Password">New password</label>
                <input asp-for="Password" class="ht-control" autocomplete="new-password" autofocus />
                <span asp-validation-for="Password" class="ht-field-error"></span>
            </div>
            <div class="ht-field">
                <label asp-for="ConfirmPassword">Confirm new password</label>
                <input asp-for="ConfirmPassword" class="ht-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="ht-field-error"></span>
            </div>
            <button type="submit" class="ht-primary-button">Reset password</button>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
