@model HealthTrack.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign in to HealthTrack";
}
<h1>Sign in</h1>
<p>Use the same sign-in page whether you are a client, trainer or administrator.</p>

<form asp-controller="Account" asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <input asp-for="ReturnUrl" type="hidden" />
    <p>
        <label asp-for="UserNameOrEmail">Username or email</label><br />
        <input asp-for="UserNameOrEmail" autocomplete="username" autofocus />
        <span asp-validation-for="UserNameOrEmail"></span>
    </p>
    <p>
        <label asp-for="Password">Password</label><br />
        <input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password"></span>
    </p>
    <p>
        <input asp-for="RememberMe" />
        <label asp-for="RememberMe">Remember me on this device</label>
    </p>
    @if (ViewData["ShowResendLink"] is true)
    {
        <p><a asp-controller="Account" asp-action="ResendConfirmation">Resend the confirmation email</a></p>
    }
    <button type="submit">Sign in</button>
</form>
<p><a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a></p>
<p>New to HealthTrack? <a asp-controller="Account" asp-action="Register">Create an account</a></p>
<p>Accounts must have a confirmed email address. Trainer accounts must also be approved by an administrator. After 5 failed attempts an account is locked for 10 minutes.</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
