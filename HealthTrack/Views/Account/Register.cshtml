@model HealthTrack.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create your HealthTrack account";
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="ht-auth-page">
    <section class="ht-auth-card ht-auth-card-wide">
        <div class="ht-auth-brand">
            <div class="ht-brand-mark"><span>H</span></div>
            <div>
                <div class="ht-brand-name">HealthTrack</div>
                <div class="ht-brand-caption">Personal health &amp; fitness management</div>
            </div>
        </div>

        <header class="ht-auth-heading">
            <p class="ht-eyebrow">GET STARTED</p>
            <h1>Create your account</h1>
            <p>Choose your role and enter the details needed for your profile.</p>
        </header>

        <form asp-controller="Account" asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="ht-validation-summary" role="alert"></div>

            <div class="ht-section-title">Account details</div>
            <div class="ht-form-grid">
                <div class="ht-field ht-field-full">
                    <label asp-for="AccountType">Register as <span class="ht-required">*</span></label>
                    <select asp-for="AccountType" id="accountType" class="ht-control">
                        <option value="">Choose your role</option>
                        <option value="Client">Client</option>
                        <option value="Trainer">Trainer</option>
                    </select>
                    <span asp-validation-for="AccountType" class="ht-field-error"></span>
                    <small class="ht-hint">Administrator accounts are created by an existing administrator.</small>
                </div>

                <div class="ht-field">
                    <label asp-for="FullName">Full name <span class="ht-required">*</span></label>
                    <input asp-for="FullName" class="ht-control" autocomplete="name" placeholder="Enter your full name" />
                    <span asp-validation-for="FullName" class="ht-field-error"></span>
                </div>
                <div class="ht-field">
                    <label asp-for="UserName">Username <span class="ht-required">*</span></label>
                    <input asp-for="UserName" class="ht-control" autocomplete="username" placeholder="Choose a username" />
                    <span asp-validation-for="UserName" class="ht-field-error"></span>
                </div>
                <div class="ht-field ht-field-full">
                    <label asp-for="Email">Email address <span class="ht-required">*</span></label>
                    <input asp-for="Email" class="ht-control" autocomplete="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="ht-field-error"></span>
                </div>
                <div class="ht-field">
                    <label asp-for="Password">Password <span class="ht-required">*</span></label>
                    <input asp-for="Password" class="ht-control" autocomplete="new-password" placeholder="At least 8 characters" />
                    <span asp-validation-for="Password" class="ht-field-error"></span>
                </div>
                <div class="ht-field">
                    <label asp-for="ConfirmPassword">Confirm password <span class="ht-required">*</span></label>
                    <input asp-for="ConfirmPassword" class="ht-control" autocomplete="new-password" placeholder="Re-enter your password" />
                    <span asp-validation-for="ConfirmPassword" class="ht-field-error"></span>
                </div>
            </div>

            <section id="clientFields" class="ht-role-panel" hidden>
                <div class="ht-section-title">Health and fitness profile</div>
                <p class="ht-section-description">These details help HealthTrack personalize your fitness experience.</p>
                <div class="ht-form-grid">
                    <div class="ht-field">
                        <label asp-for="Age">Age <span class="ht-required">*</span></label>
                        <input asp-for="Age" class="ht-control" type="number" min="1" max="120" placeholder="Age in years" />
                        <span asp-validation-for="Age" class="ht-field-error"></span>
                    </div>
                    <div class="ht-field">
                        <label asp-for="Gender">Gender <span class="ht-required">*</span></label>
                        <select asp-for="Gender" class="ht-control">
                            <option value="">Select gender</option>
                            <option>Female</option>
                            <option>Male</option>
                            <option>Non-binary</option>
                            <option>Other</option>
                            <option>Prefer not to say</option>
                        </select>
                        <span asp-validation-for="Gender" class="ht-field-error"></span>
                    </div>
                    <div class="ht-field">
                        <label asp-for="HeightCm">Height (cm) <span class="ht-required">*</span></label>
                        <input asp-for="HeightCm" class="ht-control" type="number" min="50" max="300" step="0.1" placeholder="e.g. 170" />
                        <span asp-validation-for="HeightCm" class="ht-field-error"></span>
                    </div>
                    <div class="ht-field">
                        <label asp-for="WeightKg">Weight (kg) <span class="ht-required">*</span></label>
                        <input asp-for="WeightKg" class="ht-control" type="number" min="10" max="500" step="0.1" placeholder="e.g. 65" />
                        <span asp-validation-for="WeightKg" class="ht-field-error"></span>
                    </div>
                    <div class="ht-field ht-field-full">
                        <label asp-for="FitnessGoals">Fitness goals <span class="ht-required">*</span></label>
                        <textarea asp-for="FitnessGoals" class="ht-control ht-textarea" rows="3" placeholder="What would you like to work towards?"></textarea>
                        <span asp-validation-for="FitnessGoals" class="ht-field-error"></span>
                    </div>
                </div>
            </section>

            <section id="trainerFields" class="ht-role-panel" hidden>
                <div class="ht-section-title">Professional profile</div>
                <p class="ht-section-description">Trainer accounts require administrator approval after registration.</p>
                <div class="ht-form-grid">
                    <div class="ht-field ht-field-full">
                        <label asp-for="Qualifications">Professional qualifications <span class="ht-required">*</span></label>
                        <textarea asp-for="Qualifications" class="ht-control ht-textarea" rows="2" placeholder="Degrees, diplomas or relevant qualifications"></textarea>
                        <span asp-validation-for="Qualifications" class="ht-field-error"></span>
                    </div>
                    <div class="ht-field ht-field-full">
                        <label asp-for="Specializations">Specializations <span class="ht-required">*</span></label>
                        <textarea asp-for="Specializations" class="ht-control ht-textarea" rows="2" placeholder="e.g. strength training, weight management"></textarea>
                        <span asp-validation-for="Specializations" class="ht-field-error"></span>
                    </div>
                    <div class="ht-field ht-field-full">
                        <label asp-for="Certifications">Certifications <span class="ht-optional">Optional</span></label>
                        <textarea asp-for="Certifications" class="ht-control ht-textarea" rows="2" placeholder="List relevant certifications, if any"></textarea>
                        <span asp-validation-for="Certifications" class="ht-field-error"></span>
                    </div>
                </div>
            </section>

            <label class="ht-checkbox-line mt-3" style="align-items:flex-start">
                <input asp-for="AcceptPrivacyPolicy" />
                <span>I have read and agree to the <a asp-controller="Home" asp-action="Privacy" target="_blank">privacy policy</a>. I consent to HealthTrack storing my health and fitness data to provide the service. I can download or delete my data at any time.</span>
            </label>
            <span asp-validation-for="AcceptPrivacyPolicy" class="ht-field-error"></span>

            <p class="ht-privacy-note"><span aria-hidden="true">&#128274;</span> Passwords are hashed (PBKDF2 with 100,000 iterations) and sensitive health notes are encrypted. Use at least 8 characters with upper- and lower-case letters, a number and a symbol.</p>
            <button type="submit" class="ht-primary-button">Create account <span aria-hidden="true">&#8594;</span></button>
            <p class="ht-auth-switch">Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a></p>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var roleSelect = document.getElementById('accountType');
            var clientFields = document.getElementById('clientFields');
            var trainerFields = document.getElementById('trainerFields');

            function updateRoleFields() {
                var role = roleSelect.value;
                clientFields.hidden = role !== 'Client';
                trainerFields.hidden = role !== 'Trainer';
            }

            roleSelect.addEventListener('change', updateRoleFields);
            updateRoleFields();
        })();
    </script>
}
