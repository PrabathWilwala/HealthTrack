@model ClientProgressReport
@{
    ViewData["Title"] = "Progress & analytics";
    var days = (int)(ViewData["Days"] ?? 30);
}
<h1>Progress &amp; analytics</h1>
<p>@Model.From.ToString("dd MMM yyyy") - @Model.To.ToString("dd MMM yyyy")</p>
<p>
    Period:
    @foreach (var d in new[] { 7, 30, 90, 180, 365 })
    {
        if (d == days) { <b>@(d == 365 ? "1 y" : d + " d")</b> } else { <a asp-route-days="@d">@(d == 365 ? "1 y" : d + " d")</a> }
        <text> </text>
    }
</p>
<p>
    Grouping:
    <a asp-route-days="@days" asp-route-grouping="Day">Daily</a> |
    <a asp-route-days="@days" asp-route-grouping="Week">Weekly</a> |
    <a asp-route-days="@days" asp-route-grouping="Month">Monthly</a>
    (current: @Model.Grouping)
</p>
<p>
    Export:
    <a asp-action="Export" asp-route-format="pdf" asp-route-days="@days">PDF report</a> |
    <a asp-action="Export" asp-route-format="csv" asp-route-days="@days">CSV data</a>
</p>
<partial name="_ProgressCharts" model="Model" />
