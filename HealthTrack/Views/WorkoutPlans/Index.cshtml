@model PlanIndexViewModel
@{
    var isWorkout = Model.PlanType == "Workout";
    var controller = isWorkout ? "WorkoutPlans" : "DietPlans";
    ViewData["Title"] = Model.IsAdministrator ? $"System {Model.PlanType.ToLower()} templates" : $"{Model.PlanType} plans";
}
<h1>@ViewData["Title"]</h1>
<p>@(Model.IsAdministrator
    ? "Templates you publish here are available to every trainer."
    : isWorkout ? "Personalised workout programmes for your clients, plus your reusable templates." : "Personalised nutrition plans for your clients, plus your reusable templates.")</p>
<p><a asp-controller="@controller" asp-action="Create">@(Model.IsAdministrator ? "New system template" : $"New {Model.PlanType.ToLower()} plan")</a></p>

@if (!Model.IsAdministrator)
{
    <h2>My plans (@Model.Plans.Count)</h2>
    @if (Model.Plans.Count == 0)
    {
        <p>No plans yet. Create one from scratch or start from a template below.</p>
    }
    else
    {
        <table border="1" cellpadding="4">
            <thead><tr><th>Plan</th><th>Summary</th><th>Active clients</th><th>Updated</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Plans)
                {
                    <tr>
                        <td><a asp-controller="@controller" asp-action="Details" asp-route-id="@p.Id">@p.Title</a>
                            @if (p.IsFlagged) { <b title="@p.FlagReason">(Flagged)</b> }
                            <br /><small>@p.Description</small></td>
                        <td>@p.Summary</td>
                        <td>@p.ActiveAssignments</td>
                        <td>@DateHelpers.TimeAgo(p.UpdatedAtUtc)</td>
                        <td>
                            <a asp-controller="@controller" asp-action="Assign" asp-route-id="@p.Id">Assign</a> |
                            <a asp-controller="@controller" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                            <form asp-controller="@controller" asp-action="SaveAsTemplate" asp-route-id="@p.Id" method="post">
                                <button type="submit">Save as template</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<h2>Template library (@Model.Templates.Count)</h2>
@if (Model.Templates.Count == 0)
{
    <p>No templates yet. Tick "Save as a reusable template" when creating a plan.</p>
}
else
{
    <table border="1" cellpadding="4">
        <thead><tr><th>Template</th><th>Owner</th><th>Description</th><th>Summary</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var t in Model.Templates)
            {
                <tr>
                    <td><a asp-controller="@controller" asp-action="Details" asp-route-id="@t.Id">@t.Title</a></td>
                    <td>@(t.IsSystemTemplate ? "System" : "Mine")</td>
                    <td>@t.Description</td>
                    <td>@t.Summary</td>
                    <td>
                        @if (!Model.IsAdministrator)
                        {
                            <form asp-controller="@controller" asp-action="UseTemplate" asp-route-id="@t.Id" method="post">
                                <button type="submit">Use template</button>
                            </form>
                        }
                        @if (t.CanEdit)
                        {
                            <a asp-controller="@controller" asp-action="Edit" asp-route-id="@t.Id">Edit</a>
                            <form asp-controller="@controller" asp-action="Delete" asp-route-id="@t.Id" method="post" data-confirm="Delete this template?">
                                <button type="submit">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
