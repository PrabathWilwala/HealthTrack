@model WorkoutPlan
@{
    ViewData["Title"] = Model.Title;
    var canEdit = ViewData["CanEdit"] is true;
    var isTrainer = User.IsInRole(RoleNames.Trainer);
    var days = Model.Exercises.OrderBy(e => e.SortOrder).GroupBy(e => e.DayOfWeek).OrderBy(g => g.Key.HasValue ? ((int)g.Key.Value + 6) % 7 : 7);
}
<p><a asp-action="Index">&lt; Workout plans</a></p>
<h1>@Model.Title</h1>
<p>@Model.Description</p>
@if (isTrainer && !Model.IsTemplate && canEdit)
{
    <p><a asp-action="Assign" asp-route-id="@Model.Id">Assign to clients</a></p>
}
@if (isTrainer && Model.IsTemplate)
{
    <form asp-action="UseTemplate" asp-route-id="@Model.Id" method="post"><button type="submit">Use template</button></form>
}
@if (canEdit)
{
    <p><a asp-action="Edit" asp-route-id="@Model.Id">Edit</a></p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Delete this plan? Client assignments of this plan will also be removed.">
        <button type="submit">Delete</button>
    </form>
}
@if (Model.IsFlagged)
{
    <p><b>This plan was flagged by an administrator:</b> @Model.FlagReason</p>
}
<table border="1" cellpadding="4">
    <tr><th>Intensity</th><td>@Model.Intensity</td></tr>
    <tr><th>Sessions / week</th><td>@Model.SessionsPerWeek</td></tr>
    <tr><th>Duration</th><td>@Model.DurationWeeks weeks</td></tr>
    <tr><th>Goal</th><td>@(Model.Goal ?? "-")</td></tr>
    @if (Model.IsTemplate) { <tr><th>Type</th><td>@(Model.IsSystemTemplate ? "System template" : "Template")</td></tr> }
</table>

<h2>Exercises</h2>
<table border="1" cellpadding="4">
    <thead><tr><th>Day</th><th>Exercise</th><th>Sets</th><th>Reps</th><th>Minutes</th><th>Notes</th></tr></thead>
    <tbody>
        @foreach (var group in days)
        {
            foreach (var e in group)
            {
                <tr>
                    <td>@(group.Key?.ToString() ?? "Any day")</td>
                    <td>@e.Name</td>
                    <td>@(e.Sets > 0 ? e.Sets.ToString() : "-")</td>
                    <td>@(e.Reps > 0 ? e.Reps.ToString() : "-")</td>
                    <td>@(e.DurationMinutes > 0 ? e.DurationMinutes.ToString() : "-")</td>
                    <td>@e.Notes</td>
                </tr>
            }
        }
    </tbody>
</table>
